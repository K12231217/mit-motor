{
  // Shared settings only. Personal preferences belong in user settings.
  // The root Cargo.toml is the host workspace; point rust-analyzer at the
  // firmware crate. Its target and runner come from software/firmware/.cargo/config.toml.
  "rust-analyzer.linkedProjects": ["software/firmware/Cargo.toml"],
  "rust-analyzer.check.command": "clippy",
  "files.eol": "\n"
}
